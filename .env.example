# Base de datos PostgreSQL con pgvector
DATABASE_URL=postgres://postgres:postgres@localhost:5432/webia

# Seguridad
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRES_IN=8h

# Proveedor de IA generativa (Groq)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# Embeddings (OpenAI). Si no se define, se usa un fallback local determinista.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# API key para consumidores externos (Power BI / Postman)
BI_API_KEY=demo-bi-key-123

# Servidor
PORT=3000
NODE_ENV=development

# Umbral de similitud para RAG (0 a 1). Debajo de esto = "sin información suficiente".
RAG_MIN_SCORE=0.68
RAG_TOP_K=5
